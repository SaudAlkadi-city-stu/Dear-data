String[] lines;

String[] dates = new String[100];
String[][] foods = new String[100][100];
int[][] calories = new int[100][100];
int[] foodCount = new int[100];
int[] totals = new int[100];

int dateCount = 0;

void setup() {
  size(600, 500);

  lines = loadStrings("food.txt");

  int currentDate = -1;

  for (int i = 0; i < lines.length; i++) {

    String line = trim(lines[i]);

    if (line.equals("")) {
      continue;
    }

    if (!line.contains(",")) {
      dates[dateCount] = line;
      currentDate = dateCount;
      dateCount++;
    } else {
      String[] parts = split(line, ',');

      foods[currentDate][foodCount[currentDate]] = parts[0];
      calories[currentDate][foodCount[currentDate]] = int(parts[1]);

      foodCount[currentDate]++;
    }
  }

  for (int i = 0; i < dateCount; i++) {

    println(dates[i]);

    int total = 0;

    for (int j = 0; j < foodCount[i]; j++) {
      println(foods[i][j] + " - " + calories[i][j] + " calories");

      total = total + calories[i][j];
    }

    totals[i] = total;

    println("Total: " + total + " calories");
    println("");
  }

  background(255);

  for (int i = 0; i < dateCount; i++) {

    int x = 75 + (i % 5) * 110;
    int y = 80 + (i / 5) * 110;

    float circleSize = map(totals[i], 0, 3000, 37, 63);
    circleSize = constrain(circleSize, 37, 63);

    fill(random(255), random(255), random(255));
    ellipse(x, y, circleSize, circleSize);

    fill(0);
    textAlign(CENTER);
    text(dates[i], x, y + 45);
  }
}
